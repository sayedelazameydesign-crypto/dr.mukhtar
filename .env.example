# Celia Kids — environment template (names only, never values)
# Copy to .env for local work:  cp .env.example .env   (never commit .env)
# The same names are used in GitHub Actions and in Colab Secrets.

# ---------- GitHub Actions variables (safe to show in logs) ----------
APP_ENV=ci
NODE_VERSION=20
PYTHON_VERSION=3.11
LLM_PRIMARY=gemini
LLM_SMOKE_ENABLED=false
PAGES_AUTO_ENABLE=false

# ---------- Secrets (leave empty here; set via gh / .env locally) ----------
GEMINI_API_KEY=
GROQ_API_KEY=
# Environment-scoped in GitHub (production); staff PIN for the clinic backend.
CELIA_ADMIN_PIN=
# Optional first-run only: lets the deploy workflow create the Pages site.
PAGES_TOKEN=

# ---------- Google bridge (docs/google-setup.md) ----------
# Profile selects the account; the token secret name is derived from it:
# GOOGLE_PROFILE=dev  ->  GOOGLE_REFRESH_TOKEN_DEV
GOOGLE_PROFILE=dev
GOOGLE_AUTH_MODE=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One refresh-token name per profile. A second profile adds a second name.
GOOGLE_REFRESH_TOKEN_DEV=

# ---------- Local-only mirrors of Apps Script Script Properties ----------
# Used by scripts/check-config.js when validating a local export.
# Runtime values still live in Apps Script → Project Settings → Script Properties.
CELIA_TIMEZONE=Africa/Cairo
CELIA_WORK_START=09:00
CELIA_WORK_END=14:00
CELIA_WORK_DAYS=0,1,2,3,4
CELIA_SLOT_MINUTES=30
CELIA_LLM_DAILY_LIMIT=25
CELIA_LLM_HOURLY_LIMIT=20
CELIA_LLM_CHAIN=gemini
